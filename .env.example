# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_URL=https://your-domain.com
VITE_APP_ID=sutaeru

# ─── Auth ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
OWNER_OPEN_ID=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Vertex AI / Gemini (preferred — uses service account) ───────────────────
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/service-account-key.json

# ─── LLM Providers (optional fallbacks) ──────────────────────────────────────
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.koboi2026.biz.id/v1
ANTHROPIC_API_KEY=
KIMI_API_KEY=
GEMINI_API_KEY=
SONAR_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
NVIDIA_API_KEY=

# ─── Kemma model routing (defaults used when blank) ──────────────────────────
KEMMA_MODEL_CHAT=qwen3.8-max
KEMMA_MODEL_SEARCH=sonar-pro
KEMMA_MODEL_VISION=gemini-3.8-flash
KEMMA_MODEL_EMBEDDING=text-embedding-004
KEMMA_MODEL_IMAGE=gemini-3.8-flash
KEMMA_MODEL_REPORT=qwen3.8-max
KEMMA_MODEL_LONG_DOC=kimi-k3
KEMMA_MODEL_PLANNER=claude-sonnet-5
KEMMA_MODEL_VERIFY=claude-sonnet-5
KEMMA_MODEL_POLISH=
KEMMA_MODEL_NEMOTRON=
KEMMA_SEARCH_RPM=40
KEMMA_MAX_SUBAGENTS=1
KEMMA_TOOL_BUDGET=60

# ─── Kemma spend caps (USD per calendar month, 0 = unlimited) ────────────────
KEMMA_CAP_ANTHROPIC=0
KEMMA_CAP_OPENAI=0

# ─── Storage (local | forge | drive) ─────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/root/sr1-data/files
STORAGE_LOCAL_URL=/files

# ─── Auth allowlist (comma-separated emails/handles; empty = no logins) ──────
ALLOWED_LOGIN=
SEED_TEST_PASSWORD=

# ─── ElevenLabs (HER voice) ───────────────────────────────────────────────────
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_AGENT_ID=
ELEVEN_LABS_VOICE_ID=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@sutaeru.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── AWS S3 (file storage) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
