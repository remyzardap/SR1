# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_URL=https://your-domain.com
VITE_APP_ID=sutaeru

# ─── Auth ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
OWNER_OPEN_ID=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Vertex AI / Gemini (preferred — uses service account) ───────────────────
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/service-account-key.json

# ─── LLM Providers ─────────────────────────────────────────────────────────────
# Qwen (OpenAI-compatible): https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1

# Gemini (Google Generative Language API)
GEMINI_API_KEY=

# Perplexity Sonar (web search)
SONAR_API_KEY=

# ─── P1-08 search provider layer (only used when FF_SEARCH_V2 is on) ─────────
# Brave Search: https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
# Tavily: https://tavily.com/
TAVILY_API_KEY=
# Exa: https://exa.ai/
EXA_API_KEY=
# Self-hosted SearXNG instance base URL (no trailing slash), e.g. https://searx.example.internal
SEARXNG_URL=
# Fast-path provider order, filtered to whichever of these are configured (default brave,tavily,sonar).
# The Perplexity Search API provider reuses PERPLEXITY_API_KEY/SONAR_API_KEY above.
KEMMA_SEARCH_PROVIDERS=brave,tavily,sonar
# Per-request cost override for one provider, e.g. SEARCH_COST_BRAVE=0.004 (USD). Optional, per id.
# SEARCH_COST_<ID>=

# ─── Kemma model routing (defaults used when blank) ──────────────────────────
KEMMA_MODEL_CHAT=qwen3.8-max
KEMMA_MODEL_SEARCH=sonar-pro
KEMMA_MODEL_VISION=gemini-3.8-flash
KEMMA_MODEL_EMBEDDING=gemini-embedding-2
KEMMA_MODEL_IMAGE=gemini-2.5-flash-image
KEMMA_MODEL_REPORT=qwen3.8-max
KEMMA_MODEL_LONG_DOC=qwen3.8-max
KEMMA_MODEL_PLANNER=gemini-3.8-flash
KEMMA_MODEL_VERIFY=gemini-3.8-flash
KEMMA_SEARCH_RPM=40
# Request efficiency (all optional; defaults shown in comments)
# Qwen explicit prompt-cache markers on the main agent loop. "off" disables. Auto-disables if the provider rejects them.
KEMMA_PROMPT_CACHE=
# Total attempts per LLM request on 429/5xx/network errors before falling back to the next model (default 3)
KEMMA_HTTP_ATTEMPTS=
# Abort a request that gets no response headers within this many ms (default 90000)
KEMMA_HTTP_TIMEOUT_MS=
# Seconds to cache identical web_search queries (default 900, 0 disables; time-sensitive queries cap at 120)
KEMMA_SEARCH_CACHE_TTL_SEC=
# Cost-estimate discount for cached prompt tokens, 0 to 1 (default 0.2 for Qwen, 0.25 for Gemini)
KEMMA_CACHED_INPUT_MULTIPLIER=
KEMMA_MAX_SUBAGENTS=1
KEMMA_TOOL_BUDGET=60

# ─── Storage (local | forge | drive) ─────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/root/sr1-data/files
STORAGE_LOCAL_URL=/files
DRIVE_ROOT_FOLDER_ID=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ─── Auth allowlist (comma-separated emails/handles; empty = no logins) ──────
ALLOWED_LOGIN=
SEED_TEST_PASSWORD=

# ─── ElevenLabs (Kemma voice) ────────────────────────────────────────────────
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_AGENT_ID=
ELEVEN_LABS_VOICE_ID=
# Voice colour: all optional, defaults tuned for the warm spoken persona
# (see ENVIRONMENT_VARIABLES.md for the exact defaults and ranges)
ELEVEN_LABS_TTS_MODEL_ID=
ELEVEN_LABS_AGENT_TTS_MODEL_ID=
ELEVEN_LABS_VOICE_STABILITY=
ELEVEN_LABS_VOICE_SIMILARITY_BOOST=
ELEVEN_LABS_VOICE_STYLE=
ELEVEN_LABS_VOICE_SPEAKER_BOOST=
ELEVEN_LABS_VOICE_SPEED=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@sutaeru.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── AWS S3 (file storage) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Shared secret Telegram must send back in the X-Telegram-Bot-Api-Secret-Token
# header on every webhook call. 1-256 chars, A-Za-z0-9_- only. Set this when
# calling setWebhook (see deploy notes) - the webhook is disabled without it.
TELEGRAM_WEBHOOK_SECRET=

# Comma separated user ids that skip quota checks (owner accounts, eval runs). Empty = nobody.
KEMMA_UNLIMITED_USER_IDS=
# Research eval harness (npm run eval:research) and chat bench (npm run bench).
# The bench needs EVAL_USER_ID (or --user <id>); put that id in KEMMA_UNLIMITED_USER_IDS too.
EVAL_USER_ID=
EVAL_DB_HOST=
EVAL_JUDGE_MODEL=

# Agent skills and MCP (optional overrides; defaults are ./skills and ./mcp.config.json)
SKILLS_DIR=
MCP_CONFIG=

# Job runner (pg-boss). Set JOBS_ENABLED=false to turn it off.
JOBS_ENABLED=
# Enables POST /api/jobs/tick (send it in the x-jobs-secret header). For Cloud Run + Cloud Scheduler. Empty = endpoint disabled.
JOBS_TICK_SECRET=

# ─── Feature flags (server/core/flags.ts) ────────────────────────────────────
# 1/true/on = on, any other value = off, blank = the default in brackets.
# Stream every model call, tool turns included (P1-03) [off]
FF_STREAM_TOOL_TURNS=
# Run parallel-safe tool calls of one step concurrently (P1-04) [off]
FF_PARALLEL_TOOLS=
# Continue an answer cut off by the output limit, at most twice (P1-06) [off]
FF_AUTO_CONTINUE=
# Search through the provider layer instead of Sonar (P1-08) [off]
FF_SEARCH_V2=
# Tiered page reader instead of a browser agent per URL (P1-09) [off]
FF_READER_V2=
# Fence outside content in tool results as data (P1-10) [on; set 0 to turn off]
FF_UNTRUSTED_FENCING=
# Ask the user before write tools that act outside Sutaeru (P1-11) [off]
FF_APPROVALS=
# Email, calendar, image, video and monitor tools for the agent (P1-12) [off]
FF_ACTION_TOOLS=
# Token budgets, result handles and compaction (P1-13) [off]
FF_CONTEXT_MANAGER=

# ─── Tests ────────────────────────────────────────────────────────────────────
# Scratch Postgres for npm run test:db; *.db.test.ts skip when blank. Migrate it first
# (DATABASE_URL=$TEST_DATABASE_URL npm run migrate). Never a real database: the tests write and delete rows.
TEST_DATABASE_URL=
